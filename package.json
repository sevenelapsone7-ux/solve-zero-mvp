app.use(cors());
app.use(express.json());

app.get('/api/categories', (req, res) => {
  res.json({ data: categories });
});

app.get('/api/offers', (req, res) => {
  const { query = '', category = '', location = '', budget = '' } = req.query;
  const q = String(query).toLowerCase();
  const filtered = offers.filter((item) => {
    const matchesText = !q || item.title.toLowerCase().includes(q) || item.provider.toLowerCase().includes(q);
    const matchesLocation = !location || item.location.toLowerCase().includes(String(location).toLowerCase());
    const matchesCategory = !category || category === 'Outros' || item.category === category;
    const matchesBudget = !budget || Number(item.price) <= Number(budget || 999999999);
    return matchesText && matchesLocation && matchesCategory && matchesBudget;
  });

  res.json({ data: filtered });
});

app.get('/api/suppliers', (req, res) => {
  res.json({ data: suppliers });
});

app.get('/api/orders', (req, res) => {
  res.json({ data: orders });
});

app.get('/api/transactions', (req, res) => {
  res.json({ data: transactions });
});

app.post('/api/orders', (req, res) => {
  const { product, provider, amount, paymentMethod, phoneNumber } = req.body || {};
  const newOrder = {
    id: `SOL-${String(Date.now()).slice(-6)}`,
    product: product || 'Pedido novo',
    provider: provider || 'Fornecedor',
    amount: amount || 0,
    paymentMethod: paymentMethod || 'mKesh',
    phoneNumber: phoneNumber || '',
    status: 'Pago'
  };

  orders.unshift(newOrder);
  transactions.unshift({
    id: `TX-${String(Date.now()).slice(-3)}`,
    buyer: 'Cliente novo',
    vendor: provider || 'Fornecedor',
    total: amount || 0,
    status: 'Concluído'
  });

  res.status(201).json({
    ok: true,
    data: newOrder,
    message: 'Pedido recebido e preparado para processamento.'
  });
});

